{
  "name": "p-note",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "node node_modules/@cloudflare/vitest-plugin/node_modules/wrangler/bin/wrangler.js dev --config wrangler.probe.jsonc --ip 127.0.0.1 --port 8787 --local",
    "dev:test-worker": "node node_modules/@cloudflare/vitest-plugin/node_modules/wrangler/bin/wrangler.js dev --config wrangler.test.jsonc --ip 127.0.0.1 --port 8787 --local --persist-to .wrangler/test-state",
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "test:build": "npm run build && node scripts/test-build.mjs",
    "test:spec-coverage": "node scripts/spec-coverage.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "worker:types": "node node_modules/@cloudflare/vitest-plugin/node_modules/wrangler/bin/wrangler.js types --config wrangler.app.jsonc",
    "test:probe": "npm test && npm run test:spec-coverage -- --probe",
    "check:spec": "node scripts/check-spec.mjs",
    "validate:probe": "npm run test:probe && npm run check && npm run build && npm run check:spec"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@zip.js/zip.js": "2.23.0",
    "better-auth": "1.7.7",
    "lib0": "0.2.119",
    "partyserver": "0.5.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "y-indexeddb": "9.0.12",
    "y-partyserver": "2.2.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
