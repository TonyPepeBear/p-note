{
  "$schema": "./node_modules/@cloudflare/vitest-plugin/node_modules/wrangler/config-schema.json",
  "name": "p-note-local-probe",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ProbeRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "p-note-local-probe", "database_id": "00000000-0000-0000-0000-000000000001" }],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "p-note-local-probe" }]
}
