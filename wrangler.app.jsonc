{
  "$schema": "./node_modules/@cloudflare/vitest-plugin/node_modules/wrangler/config-schema.json",
  "name": "p-note-local-app",
  "main": "src/worker/app.ts",
  "assets": { "directory": "./dist", "binding": "STATIC", "run_worker_first": true },
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "secrets": { "required": ["OWNER_EMAIL", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "SENDER_EMAIL", "API_KEY_ENCRYPTION_SECRET"] },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["0 19 * * *"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ProbeRoom" }, { "name": "SYNC", "class_name": "SyncRoom" }, { "name": "RESTORES", "class_name": "RestoreCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeRoom", "SyncRoom"] }, { "tag": "v2", "new_sqlite_classes": ["RestoreCoordinator"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "p-note-local-app", "database_id": "00000000-0000-0000-0000-000000000002", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000008" }],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "p-note-local-app" }, { "binding": "BACKUPS", "bucket_name": "p-note-local-app-backups" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
