{
  "name": "p-note-local-test",
  "main": "tests/runtime.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "OWNER_EMAIL": "owner@example.test", "BETTER_AUTH_URL": "http://127.0.0.1:5173", "BETTER_AUTH_SECRET": "test-only-secret-with-at-least-32-characters", "SENDER_EMAIL": "noreply@example.test" },
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ProbeRoom" }, { "name": "SYNC", "class_name": "SyncRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeRoom", "SyncRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "p-note-local-test", "database_id": "00000000-0000-0000-0000-000000000003" }],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "p-note-local-test" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
